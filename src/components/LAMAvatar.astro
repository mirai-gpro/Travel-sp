---
// LAMAvatar.astro - Gaussian Splatting 3Dアバターコンポーネント
// LAM_gpro より移植・改修（仕様書08 セクション6）
//
// 【改修ポイント】
// - 旧: HTML <audio> 要素の currentTime で同期
// - 新: LiveAudioManager の getCurrentPlaybackOffset() で同期
// - 公式API: GaussianSplatRenderer.getInstance(div, assetPath, callbacks)

export interface Props {
  modelUrl?: string;
}

const {
  modelUrl = '/avatar/meruru.zip',
} = Astro.props;
---

<div class="lam-avatar-wrapper" id="lamAvatarWrapper">
  <!-- GaussianSplatRenderer がマウントされるdiv -->
  <div id="lamAvatarContainer" class="lam-avatar-container"></div>
  <!-- フォールバック: WebGL未対応時にアバター画像を表示 -->
  <img
    id="lamAvatarFallback"
    src="/images/avatar-anime.png"
    alt="AI Avatar"
    class="lam-avatar-fallback hidden"
  />
  <div id="lamAvatarLoading" class="lam-loading">
    <div class="lam-spinner"></div>
    <p>Loading 3D Avatar...</p>
  </div>
</div>

<style>
.lam-avatar-wrapper {
  position: relative;
  width: 100%;
  height: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  overflow: hidden;
}

.lam-avatar-container {
  width: 100%;
  height: 100%;
  overflow: hidden;
  position: relative;
}

/* ライブラリが生成するcanvasをコンテナ内に収める（:globalで動的要素に適用） */
/* UIKA Native 133K hidden PoC のときだけ等倍表示にする */
.lam-avatar-container.uika-133k :global(canvas) {
  transform: none !important;
}

.lam-avatar-container :global(canvas) {
  width: 100% !important;
  height: 100% !important;
  max-width: 100% !important;
  max-height: 100% !important;
  display: block;
  transform: scale(1.4);
}

.lam-avatar-fallback {
  width: 100%;
  height: 100%;
  object-fit: contain;
  filter: drop-shadow(0 4px 6px rgba(0,0,0,0.2));
  transition: opacity 0.3s, transform 0.3s;
}

.lam-avatar-fallback.hidden {
  display: none;
}

.lam-avatar-fallback.speaking {
  animation: breathe 1s infinite alternate ease-in-out;
  filter: drop-shadow(0 0 15px rgba(6, 182, 212, 0.6));
}

@keyframes breathe {
  0% { transform: scale(1); }
  100% { transform: scale(1.05) translateY(-2px); }
}

.lam-loading {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  text-align: center;
  color: #666;
  font-size: 12px;
}

.lam-loading.hidden {
  display: none;
}

.lam-spinner {
  width: 30px;
  height: 30px;
  border: 3px solid rgba(6, 182, 212, 0.3);
  border-top-color: #06b6d4;
  border-radius: 50%;
  animation: spin 1s linear infinite;
  margin: 0 auto 8px;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}
</style>

<script define:vars={{ modelUrl }}>
  // localStorageに選択アバターのmodelUrlがあればそちらを優先
  const mode = window.location.pathname.includes('concierge') ? 'concierge' : 'lesson';
  const storedUrl = localStorage.getItem('selectedAvatarUrl_' + mode);
  window.__lamAvatarConfig = { modelUrl: storedUrl || modelUrl };
</script>

<script>
  import { LAMWebSocketManager } from '../scripts/chat/lam-websocket-manager';
  import { AudioSyncPlayer } from '../scripts/chat/audio-sync-player';
  import type { LiveAudioManager, ExpressionFrame } from '../scripts/chat/live-audio-manager';
  import { getUikaExprPath } from '../scripts/chat/uika-133k-mode';
  import { isA2ETraceMode } from '../scripts/chat/a2e-replay';
  import { loadAvatarConfig, type AvatarDef } from '../config/avatar-config';
  import {
    AvatarInstallManager, defaultDeps, usesLocalPackage,
  } from '../scripts/avatar-install/avatar-install-manager';
  import { fetchManifest, findEntry, type ManifestAvatarEntry }
    from '../scripts/avatar-install/avatar-manifest';
  import { getPwaEnvironment, shouldDeferInstallToHomeScreen }
    from '../scripts/avatar-install/pwa-environment';
  import {
    mountPoster, renderInstallPrompt, renderRecoveryPrompt,
    renderHomeScreenGuide, renderUpdateNotice,
  } from '../scripts/avatar-install/install-ui';
  import { ObjectUrlOwner } from '../scripts/avatar-install/avatar-cache';

  /**
   * LAMAvatarController - LAMAvatar コンポーネントの制御クラス
   *
   * 仕様書08 セクション6.1, 6.2:
   * - External TTS Player モードから LiveAudioManager モードへ
   * - getExpressionData() は LiveAudioManager.getCurrentExpressionFrame() 直接呼び出し
   * - 公式API: GaussianSplatRenderer.getInstance(div, assetPath, callbacks)
   */
  class LAMAvatarController {
    private lamManager: LAMWebSocketManager;
    private syncPlayer: AudioSyncPlayer;
    private containerEl: HTMLDivElement;
    private fallbackEl: HTMLImageElement;
    private loadingEl: HTMLElement;
    private isInitialized: boolean = false;
    private useFallback: boolean = false;
    /** FULL133 等の local package avatar のときだけ作る。 */
    private installManager: AvatarInstallManager | null = null;
    private installAvatarId: string | null = null;
    private installAvatar: AvatarDef | null = null;
    private poster: { revealRenderer(): void; destroy(): void } | null = null;
    private retryInitialize: (() => void) | null = null;
    /** renderer へ渡した blob URL。所有権はこちらが持ち、作り直し / 破棄時に revoke する。 */
    private readonly objectUrls = new ObjectUrlOwner();
    /** 同じ起動で pending から active へ 1 回だけ fallback するためのフラグ。 */
    private pendingFallbackUsed: boolean = false;

    constructor() {
      this.lamManager = new LAMWebSocketManager();
      this.syncPlayer = new AudioSyncPlayer();
      this.containerEl = document.getElementById('lamAvatarContainer') as HTMLDivElement;
      this.fallbackEl = document.getElementById('lamAvatarFallback') as HTMLImageElement;
      this.loadingEl = document.getElementById('lamAvatarLoading') as HTMLElement;
    }

    /**
     * LiveAudioManager をバインドして初期化
     * ConciergeController.linkLamAvatar() から呼ばれる
     */
    async initialize(liveAudioManager: LiveAudioManager): Promise<void> {
      if (this.isInitialized) return;
      // install / recovery の完了後に同じ引数でやり直せるようにしておく。
      // やり直す前に前回の blob URL を必ず解放する (所有権はこちら側)。
      this.retryInitialize = () => {
        this._revokeObjectUrl();
        void this.initialize(liveAudioManager);
      };

      // AudioSyncPlayer に LiveAudioManager をバインド
      this.syncPlayer.bindLiveAudioManager(liveAudioManager);

      // expression 更新コールバックを設定
      this.syncPlayer.setExpressionCallback((frame: ExpressionFrame | null) => {
        this.lamManager.updateExpression(frame);
      });

      // Gaussian Splat レンダラーを初期化（公式API: getInstance）
      const config = (window as any).__lamAvatarConfig || {};
      // UIKA Native 133K hidden PoC: ?uika133k=1 のときだけ UIKA ZIP を使う。
      // avatar-config には載せないので、通常利用者はこの ZIP を取得しない。
      let uika133k = false;
      try {
        uika133k = new URLSearchParams(location.search).get('uika133k') === '1';
      } catch (e) { /* noop */ }
      if (uika133k) {
        // canvas の transform: scale(1.4) は Travel-sp の表示上の寄せであって
        // meta.json の camera ではない。UIKA mode では等倍にする。
        this.containerEl.classList.add('uika-133k');
        // ===== 診断用 A/B: expression frame の取得経路だけを切り替える =====
        //   exprPath=provider (既定 / 現状維持):
        //     renderer の getExpressionData() から
        //     liveAudioManager.getCurrentExpressionFrame() を直接呼ぶ
        //   exprPath=cache:
        //     provider を設定せず、通常 LAM と同じ
        //     AudioSyncPlayer rAF → updateExpression() → currentExpression 経路にする
        // モデル / 描画条件 / A2E 値 / 口形補正は一切変えていない。
        const exprPath = getUikaExprPath();
        if (exprPath === 'provider') {
          this.lamManager.setExpressionProvider(
            () => liveAudioManager.getCurrentExpressionFrame()
          );
        } else {
          this.lamManager.setExpressionProvider(null);
        }
        // 診断ログを有効化 (UIKA のときだけ。通常 LAM では設定しない)
        this.lamManager.setExpressionTrace(
          exprPath,
          () => liveAudioManager.getExpressionSyncDebugState()
        );
        console.log(
          `[TRACE] UIKA exprPath=${exprPath}`
          + (exprPath === 'provider'
              ? ' (renderer 直接取得 = 現状維持)'
              : ' (AudioSyncPlayer cache = 通常 LAM と同じ timeline)')
        );
      } else if (isA2ETraceMode()) {
        // ===== 診断専用 (?a2eTrace=1) =====
        // 通常 avatar 経路 (avatar-config 経由の B80 / FULL133 など) のまま
        // setExpressionTrace() だけを有効にする。
        //   - uika133k mode には入れない (ZIP / camera / localStorage を触らない)
        //   - setExpressionProvider() は呼ばない
        //     => _getExpressionData() は従来どおり currentExpression cache を読む
        // つまり本番の cache path の挙動は変えず、trace だけが増える。
        this.lamManager.setExpressionTrace(
          'cache',
          () => liveAudioManager.getExpressionSyncDebugState()
        );
        console.log(
          '[TRACE] a2eTrace=1 (通常 avatar 経路のまま trace のみ有効 / cache path は本番と同一)'
        );
      }
      // ===== asset resolution (指示書 §26) =====
      // renderer の初期化とは分離する。FULL133 の local install 処理が
      // LAM renderer 内部へ侵食しないようにここで解決だけを済ませる。
      // uika133k は従来どおりの hidden PoC 経路なので install 機構を通さない。
      let modelUrl = uika133k
        ? '/avatar/uika-gakki-133k.zip'
        : (config.modelUrl || '/avatar/meruru.zip');
      let installedVersion: string | null = null;
      let isPendingVersion = false;
      if (!uika133k) {
        const resolved = await this._resolveAsset(modelUrl);
        if (!resolved) return;          // install / recovery / 案内 UI を出して待つ
        modelUrl = resolved.url;
        installedVersion = resolved.version;
        isPendingVersion = resolved.isPending;
      }

      try {
        await this.lamManager.initialize({
          containerElement: this.containerEl,
          modelUrl,
        });
        if (installedVersion && this.installManager && this.installAvatarId) {
          // renderer が実際にロードできた version だけを active にする (指示書 §15)。
          if (this.lamManager.isLoaded()) {
            await this.installManager.markLoadSucceeded(this.installAvatarId, installedVersion);
          } else {
            await this.installManager.markLoadFailed(
              this.installAvatarId, installedVersion, 'renderer がロードできなかった');
            // pending (v4) のロードに失敗したら、**この起動のうちに** active (v3) へ戻す。
            // 次回まで待たせない。無限 retry を避けるため 1 回だけ。
            if (isPendingVersion && !this.pendingFallbackUsed) {
              this.pendingFallbackUsed = true;
              console.warn('[AvatarInstall] pending のロードに失敗。active へ fallback します');
              this.isInitialized = false;
              this.retryInitialize?.();
              return;
            }
          }
        }

        // UIKA 133K のときだけ、renderer と初期 morph warm-up の完了を待つ。
        // 通常 LAM はこの wait を通らない。
        if (uika133k && this.lamManager.isLoaded()) {
          await this.waitForUikaReadyForLive();
        }

        if (this.lamManager.isLoaded()) {
          this.loadingEl.classList.add('hidden');
          // 3D の First Frame が出たので Poster をフェードアウトする (指示書 §17)。
          this.poster?.revealRenderer();
          this.poster = null;
          this.syncPlayer.start();
          this.isInitialized = true;
          void this._checkUpdateInBackground();
          console.log('[LAMAvatar] 3Dアバター初期化完了');
        } else {
          this._showFallback();
        }
      } catch (error) {
        console.error('[LAMAvatar] 初期化エラー:', error);
        this._showFallback();
      }
    }

    /**
     * UIKA 133K の実 READY を待つ (UIKA mode 専用)。
     *
     * READY 判定の Source of Truth は `window.__uikaStatus` だけ。
     * 新しい状態管理は作らない。固定時間 sleep も使わず rAF でポーリングする。
     *
     *   必須: ready === true / splatCount === 133541 / bsCount === 51
     *   morphFast === true のときは morphFastFrames > 0 まで待つ
     *     (初回 full runMorphUpdate → skin/texture/centers 初期化 →
     *      fast path へ実際に移行したことの証明)
     *   morphFast === false (?morphFast=off の診断モード) は上記必須条件まで
     */
    private async waitForUikaReadyForLive(): Promise<void> {
      console.log('[UIKA INIT] waiting for renderer warm-up');
      const isReady = () => {
        const st = (window as any).__uikaStatus;
        if (!st) return null;
        if (st.ready !== true) return null;
        if (st.splatCount !== 133541) return null;
        if (st.bsCount !== 51) return null;
        if (st.morphFast === true && !(st.morphFastFrames > 0)) return null;
        return st;
      };
      const st = await new Promise<any>((resolve) => {
        const tick = () => {
          const s = isReady();
          if (s) {
            // READY になった同じ描画フレーム内で Live 開始まで進ませない
            requestAnimationFrame(() => resolve(s));
            return;
          }
          requestAnimationFrame(tick);
        };
        requestAnimationFrame(tick);
      });
      console.log(
        `[UIKA INIT] READY splatCount=${st.splatCount} bsCount=${st.bsCount} `
        + `fullRuns=${st.morphFullRuns} fastFrames=${st.morphFastFrames}`
      );
    }

    /**
     * フォールバック表示（静止画アバター + CSSアニメーション）
     */
    /**
     * modelUrl から avatar 定義を引き、install 機構を通すかどうかを決める。
     *
     * 戻り値が null のときは install / recovery / 案内 UI を出して待機している。
     * renderer は起動しない (破損 asset も remote への暗黙 fallback もしない)。
     */
    private async _resolveAsset(modelUrl: string):
        Promise<{ url: string; version: string | null; isPending: boolean } | null> {
      const env = getPwaEnvironment();
      if (!env.storageAvailable) {
        // Cache Storage / IndexedDB が無い環境では従来どおり remote から読む。
        return { url: modelUrl, version: null, isPending: false };
      }

      // ===== 1. Registry 優先 =====
      // avatar-config.json の取得成功を local 起動の条件にしない (offline local-first)。
      // selectedAvatarId だけ分かれば Registry + Cache Storage で解決できる。
      const selectedId = this._selectedAvatarId();
      this.installManager = new AvatarInstallManager(defaultDeps());
      if (selectedId) {
        try {
          const local = await this.installManager.resolveInstalled(selectedId);
          if (local.kind === 'LOCAL_READY') {
            this.installAvatarId = selectedId;
            this._mountPoster(null);
            console.log('[AvatarInstall] LOCAL_READY', selectedId, local.version,
                        local.isPending ? '(pending)' : '(active)');
            return { url: this._ownObjectUrl(local.objectUrl),
                     version: local.version, isPending: local.isPending };
          }
        } catch (e) {
          console.warn('[AvatarInstall] Registry 解決に失敗:', e);
        }
      }

      // ===== 2. ここで初めて avatar-config を読む =====
      // 未インストール / 不整合のときだけ。どちらにせよ download が要る場面。
      let avatar: AvatarDef | null = null;
      try {
        const list = await loadAvatarConfig();
        avatar = list.find((a) => a.modelUrl === modelUrl)
              ?? (selectedId ? list.find((a) => a.id === selectedId) ?? null : null);
      } catch (e) {
        avatar = null;
      }
      if (!usesLocalPackage(avatar as any)) {
        this.installManager = null;
        this.installAvatarId = null;
        return { url: modelUrl, version: null, isPending: false };
      }

      this.installAvatar = avatar;
      this.installAvatarId = avatar!.id;
      this._mountPoster(avatar!.posterUrl ?? null);
      const host = (this.poster as any).root as HTMLElement;

      const resolution = await this.installManager.resolveAvatarAsset(avatar as any);
      if (resolution.kind === 'LOCAL_READY') {
        return { url: this._ownObjectUrl(resolution.objectUrl),
                 version: resolution.version, isPending: resolution.isPending };
      }
      if (resolution.kind === 'LEGACY_REMOTE') {
        this.installAvatarId = null;
        return { url: resolution.assetUrl, version: null, isPending: false };
      }

      // ここから先は download が要る。iPhone Safari では先に入れさせない (指示書 §9)。
      if (shouldDeferInstallToHomeScreen(env)) {
        renderHomeScreenGuide(host, env, {});
        console.log('[AvatarInstall] iOS Safari のためホーム画面追加を案内');
        return null;
      }

      const entry = findEntry(await fetchManifest(), avatar!.id);
      if (!entry) {
        renderRecoveryPrompt(host, {
          sizeBytes: 0,
          reason: 'アバターの配布情報を取得できませんでした。通信状況をご確認ください。',
          onRetry: () => this.retryInitialize?.(),
        });
        return null;
      }

      if (resolution.kind === 'RECOVERY_REQUIRED') {
        console.warn('[AvatarInstall] RECOVERY_REQUIRED:', resolution.reason);
        renderRecoveryPrompt(host, {
          sizeBytes: entry.size, reason: resolution.reason,
          onRetry: () => void this._runInstall(host, entry, false),
        });
        return null;
      }

      const storage = await this.installManager.describeInstall(entry);
      renderInstallPrompt(host, {
        sizeBytes: entry.size,
        storageWarning: storage.likelyInsufficient
          ? '端末の空き容量が不足している可能性があります。' : null,
        onStart: () => void this._runInstall(host, entry, false),
      });
      return null;
    }

    /** 選択中の avatarId。remote config を読まずに localStorage だけで決める。 */
    private _selectedAvatarId(): string | null {
      try {
        const mode = location.pathname.includes('concierge') ? 'concierge' : 'lesson';
        return localStorage.getItem(`selectedAvatar_${mode}`);
      } catch (e) {
        return null;
      }
    }

    private _mountPoster(posterUrl: string | null): void {
      this.poster?.destroy();
      this.poster = mountPoster(this.containerEl,
                                { posterUrl: posterUrl ?? undefined });
      this.loadingEl.classList.add('hidden');
    }

    /** blob URL の所有権を持つ。前のものがあれば revoke してから差し替える。 */
    private _ownObjectUrl(url: string): string {
      return this.objectUrls.own(url);
    }

    /** retry / 破棄時に直前の blob URL を解放する。 */
    private _revokeObjectUrl(): void {
      this.objectUrls.release();
    }

    /**
     * ユーザー承認後の install 実行。
     *
     * `isUpdate` の扱いが要点 (指示書 §15):
     *   初回   … 完了したら初期化をやり直して 3D を起動する
     *   update … v3 ACTIVE のまま pendingVersion=v4 まで。
     *            現在 session の renderer / syncPlayer / v3 には一切触らない。
     *            v4 を試すのは次回の実起動時だけ。
     */
    private async _runInstall(host: HTMLElement, entry: ManifestAvatarEntry,
                              isUpdate: boolean): Promise<void> {
      if (!this.installManager || !this.installAvatarId) return;
      const ui = renderInstallPrompt(host, {
        sizeBytes: entry.size, storageWarning: null, onStart: () => {},
      });
      try {
        const rec = await this.installManager.install(
          this.installAvatarId, entry, (p) => ui.setProgress(p));
        if (rec.state !== 'INSTALLED') {
          ui.setProgress({ state: 'FAILED', receivedBytes: 0, totalBytes: entry.size,
                           ratio: null, message: rec.lastError ?? '不明なエラー' });
          return;
        }
        if (isUpdate) {
          // 現在 session では絶対に差し替えない。overlay を閉じて終わる。
          host.remove();
          console.log('[AvatarInstall] 更新準備完了。次回起動から適用します',
                      this.installAvatarId, entry.version);
          renderUpdateNotice(this.containerEl, {
            label: '更新準備が完了しました。次回起動から適用します',
            sizeBytes: 0,
            onUpdate: () => {}, onDismiss: () => {},
          });
          return;
        }
        host.querySelector('.avatar-install-card')?.remove();
        this.isInitialized = false;
        this.retryInitialize?.();
      } catch (e: any) {
        ui.setProgress({ state: 'FAILED', receivedBytes: 0, totalBytes: entry.size,
                         ratio: null, message: String(e?.message ?? e) });
      }
    }

    /**
     * 起動後に非同期で manifest を見る (指示書 §19)。
     * 失敗しても現在の avatar 利用には影響させない。
     */
    private async _checkUpdateInBackground(): Promise<void> {
      if (!this.installManager || !this.installAvatarId) return;
      try {
        const r = await this.installManager.checkForUpdate(this.installAvatarId);
        if (!r.updateAvailable || !r.entry) return;
        const entry = r.entry;
        renderUpdateNotice(this.containerEl, {
          label: '新しいアバターデータがあります',
          sizeBytes: entry.size,
          onUpdate: () => {
            const host = document.createElement('div');
            host.className = 'avatar-install-overlay';
            this.containerEl.appendChild(host);
            // 現在 session の v3 は触らない。pendingVersion を用意するだけ。
            void this._runInstall(host, entry, true);
          },
        });
      } catch (e) {
        // 現在の avatar 利用を継続する。
      }
    }

    private _showFallback(): void {
      // 3D を諦めるので blob URL を保持し続けない。
      this._revokeObjectUrl();
      this.useFallback = true;
      this.containerEl.style.display = 'none';
      this.loadingEl.classList.add('hidden');
      this.fallbackEl.classList.remove('hidden');
      console.log('[LAMAvatar] フォールバック表示に切り替え');
    }

    /**
     * 発話開始時
     */
    onSpeakingStart(): void {
      if (this.useFallback) {
        this.fallbackEl.classList.add('speaking');
      } else {
        this.lamManager.setChatState('Responding');
      }
    }

    /**
     * 発話終了時
     */
    onSpeakingEnd(): void {
      if (this.useFallback) {
        this.fallbackEl.classList.remove('speaking');
      } else {
        this.lamManager.setChatState('Idle');
      }
    }

    /**
     * expression バッファをクリア（割り込み・リセット時）
     */
    resetExpression(): void {
      this.lamManager.resetExpression();
    }

    /**
     * ブレンドシェイプ名を設定
     */
    setExpressionNames(names: string[]): void {
      this.lamManager.setExpressionNames(names);
    }

    /**
     * クリーンアップ
     */
    dispose(): void {
      this.syncPlayer.dispose();
      this.lamManager.dispose();
      this.isInitialized = false;
    }
  }

  // グローバルにインスタンスを公開（ConciergeController からアクセス用）
  (window as any).__lamAvatarController = new LAMAvatarController();
</script>
