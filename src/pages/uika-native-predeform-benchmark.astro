---
// UIKA Native Runtime v1.1 — Gate 4B-2A pre-deformation PoC.
//
// Correctness first: the pre-deformed centres are compared against the CPU reference and
// against the production 51-channel GPU distance pass, and the rendered frames are
// compared pixel for pixel, before any performance number is produced.
//
// Isolated PoC route. No Live, no Socket.IO, no AudioContext, no LAMAvatar,
// no LAMWebSocketManager, no LiveAudioManager, no GaussianSplatRenderer.
// /uika-native-replay, /uika-native-benchmark and /uika-native-draw-isolation are untouched.
---

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>UIKA Native v1 — Gate 4B-2A pre-deformation PoC</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0; min-height: 100vh; background: #111; color: #eee;
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      display: flex; flex-direction: column; align-items: center; gap: 12px; padding: 16px;
    }
    h1 { margin: 0; font-size: 18px; }
    .col { width: min(760px, calc(100vw - 32px)); }
    #viewer {
      width: min(760px, calc(100vw - 32px)); aspect-ratio: 1 / 1; position: relative;
      overflow: hidden; background: #000; border: 1px solid #444;
    }
    #viewer :global(canvas) { width: 100% !important; height: 100% !important; display: block; }
    .row { display: flex; gap: 8px; flex-wrap: wrap; }
    button { padding: 10px 14px; border: 1px solid #555; background: #222; color: #eee; cursor: pointer; font: inherit; }
    button:disabled { opacity: 0.4; cursor: default; }
    button.primary { background: #1d4ed8; border-color: #2563eb; }
    #live {
      display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 8px;
      padding: 12px; border: 1px solid #444; background: #181818;
    }
    #live div { display: flex; flex-direction: column; gap: 2px; }
    #live .k { color: #888; font-size: 11px; text-transform: uppercase; letter-spacing: .04em; }
    #live .v { font-size: 15px; }
    .ok { color: #4ade80; } .bad { color: #f87171; } .warn { color: #fbbf24; }
    pre {
      margin: 0; white-space: pre-wrap; overflow-wrap: anywhere; padding: 12px;
      border: 1px solid #444; background: #181818; max-height: 50vh; overflow-y: auto;
    }
    table { width: 100%; border-collapse: collapse; font-size: 12px; margin-bottom: 10px; }
    th, td { border: 1px solid #333; padding: 4px 6px; text-align: right; }
    th:first-child, td:first-child { text-align: left; }
    th { color: #888; font-weight: normal; }
    .note { color: #999; font-size: 12px; line-height: 1.6; }
  </style>
</head>
<body>
  <h1>UIKA Native v1 — Gate 4B-2A pre-deformation PoC</h1>
  <div id="viewer"></div>

  <div class="col row">
    <button id="start" class="primary" disabled>Start PoC</button>
    <button id="investigate" disabled>Run Difference Investigation</button>
    <button id="sweep" disabled>Run 192-Frame Sweep</button>
    <button id="tail" disabled>Run DPR1 Tail Isolation</button>
    <button id="stop" disabled>Stop</button>
    <button id="export" disabled>Export JSON</button>
    <button id="copy" disabled>Copy Results</button>
  </div>

  <div class="col" id="live"></div>
  <div class="col" id="tables"></div>

  <p class="col note">
    Keep this tab visible and in the foreground for the whole run, and keep DevTools
    closed. The run first proves correctness — neutral, five single-channel morphs and
    five real A2E frames, each compared against the CPU reference, against the production
    51-channel GPU distance pass, and pixel for pixel against the production render — and
    only then measures. Four measurements follow at full DPR (production and pre-deformed,
    fixed pose and real A2E), plus two at pixelRatio 1.0 if full DPR misses 30 fps. About
    8 minutes in total. All 133,541 Gaussians and all 51 basis channels are kept
    throughout; nothing is approximated or reduced.
  </p>

  <pre class="col" id="status">initializing…</pre>

  <script>
    import { UikaNativeRuntime } from '../scripts/chat/uika-native/uika-native-runtime';
    import { UikaNativeReplay } from '../scripts/chat/uika-native/uika-native-replay';
    import { collectGpuInfo } from '../scripts/chat/uika-native/uika-native-benchmark';
    import { UikaPredeformBenchmark, predeformOptionsFromUrl }
      from '../scripts/chat/uika-native/uika-predeform-benchmark';
    import { UikaPredeformInvestigation, investigationOptionsFromUrl, sweepOptionsFromUrl }
      from '../scripts/chat/uika-native/uika-predeform-investigation';
    import { UikaTailIsolation, tailOptionsFromUrl }
      from '../scripts/chat/uika-native/uika-tail-isolation';

    const container = document.getElementById('viewer');
    const statusEl = document.getElementById('status');
    const liveEl = document.getElementById('live');
    const tablesEl = document.getElementById('tables');
    if (!(container instanceof HTMLElement) || !(statusEl instanceof HTMLElement)
        || !(liveEl instanceof HTMLElement) || !(tablesEl instanceof HTMLElement)) {
      throw new Error('UIKA Native Gate 4B-2A: page elements missing');
    }

    const btn = {
      start: document.getElementById('start') as HTMLButtonElement,
      investigate: document.getElementById('investigate') as HTMLButtonElement,
      sweep: document.getElementById('sweep') as HTMLButtonElement,
      tail: document.getElementById('tail') as HTMLButtonElement,
      stop: document.getElementById('stop') as HTMLButtonElement,
      export: document.getElementById('export') as HTMLButtonElement,
      copy: document.getElementById('copy') as HTMLButtonElement,
    };

    const runtime = new UikaNativeRuntime(container);
    const replay = new UikaNativeReplay((w) => runtime.applyWeights(w));
    const poc = new UikaPredeformBenchmark(runtime, replay);
    const investigation = new UikaPredeformInvestigation(runtime, replay);
    const tail = new UikaTailIsolation(runtime, replay);
    (window as any).__uikaNativeV1 = runtime;
    (window as any).__uikaNativeReplay = replay;
    (window as any).__uikaPredeform = poc;
    (window as any).__uikaInvestigation = investigation;
    (window as any).__uikaTail = tail;

    let lastError: string | null = null;
    let report: any = null;

    const cell = (k: string, v: string, cls = '') =>
      `<div><span class="k">${k}</span><span class="v ${cls}">${v}</span></div>`;
    const num = (v: any, d = 2) => (typeof v === 'number' && Number.isFinite(v) ? v.toFixed(d) : '—');
    const sci = (v: any) => (typeof v === 'number' && Number.isFinite(v) ? v.toExponential(3) : '—');

    const renderLive = () => {
      const l = investigation.isRunning()
        ? { ...poc.getLive(), ...investigation.getLive() } as any
        : tail.isRunning()
          ? { ...poc.getLive(), ...tail.getLive() } as any
          : poc.getLive() as any;
      const v: any = runtime.getViewer();
      const gpu = collectGpuInfo(v?.renderer?.domElement ?? null);
      const r = runtime.report;
      const safe = (fn: () => any) => { try { return fn(); } catch { return null; } };
      const buffer = v?.getDrawingBufferInfo ? safe(() => v.getDrawingBufferInfo()) : null;
      const shader = v?.getDiagnosticShaderInfo ? safe(() => v.getDiagnosticShaderInfo()) : null;
      liveEl.innerHTML = [
        cell('tab visible', document.visibilityState, document.visibilityState === 'visible' ? 'ok' : 'bad'),
        cell('hardware GPU', gpu.isSoftware ? 'NO (software)' : (gpu.unmaskedAvailable ? 'YES' : 'UNKNOWN'),
             gpu.isSoftware ? 'bad' : (gpu.unmaskedAvailable ? 'ok' : 'warn')),
        cell('GPU', (gpu.renderer || '—').slice(0, 44)),
        cell('step', (poc.isRunning() || investigation.isRunning() || tail.isRunning())
             ? `${l.step} · ${l.phase}` : (report ? 'finished' : 'idle'),
             (poc.isRunning() || investigation.isRunning() || tail.isRunning()) ? 'warn' : ''),
        cell('elapsed', `${(l.elapsedMs / 1000).toFixed(1)} s`),
        cell('drawing buffer', buffer ? `${buffer.drawingBufferWidth}×${buffer.drawingBufferHeight}` : '—'),
        cell('pixelRatio', buffer ? num(buffer.rendererPixelRatio) : '—'),
        cell('centre source', shader ? (shader.predeformActive ? 'pre-deformed texture'
             : (shader.basisLoopPresent ? `51-basis loop (${shader.basisLoopBound})` : 'no loop')) : '—',
             shader && shader.predeformActive ? 'warn' : ''),
        cell('effective FPS', l.effectiveFPS ? l.effectiveFPS.toFixed(2) : '—'),
        cell('GPU draw p50', l.drawP50 ? `${l.drawP50.toFixed(2)} ms` : '—'),
        cell('GPU predeform p50', l.predeformP50 ? `${l.predeformP50.toFixed(2)} ms` : '—'),
        cell('GL errors', String(r.glErrorCount), r.glErrorCount === 0 ? 'ok' : 'bad'),
        cell('splats', String(r.viewerSplatCount ?? 0)),
        cell('bit-exact', report?.contract?.bitExactVerdict ?? '—',
             report?.contract ? (report.contract.bitExactVerdict === 'PASS' ? 'ok' : 'warn') : ''),
        cell('numeric', report?.contract?.numericVerdict ?? '—',
             report?.contract ? (report.contract.numericVerdict === 'PASS' ? 'ok' : 'bad') : ''),
        cell('visual', report?.contract?.visualVerdict ?? '—',
             report?.contract ? (report.contract.visualVerdict === 'PASS' ? 'ok' : 'bad') : ''),
        cell('correctness', report?.contract?.correctnessVerdict ?? report?.correctnessVerdict ?? '—',
             (report?.contract?.correctnessVerdict ?? report?.correctnessVerdict) === 'PASS' ? 'ok'
             : (report?.contract || report?.correctnessVerdict ? 'bad' : '')),
        cell('decision', report ? ((report.decision || []).join(' / ') || report.classification || '—') : '—'),
      ].join('');
    };

    const renderTables = () => {
      if (!report) { tablesEl.innerHTML = ''; return; }
      let html = '';
      if ((report.correctness || []).length > 0) {
        html += `<table>
          <tr><th>correctness case</th><th>non-zero w</th><th>max |xyz − CPU|</th>
              <th>max |dist prod − poc|</th><th>frames identical</th><th>pass</th></tr>
          ${report.correctness.map((c: any) => `<tr>
            <td>${c.name}</td><td>${c.nonZeroWeights}</td>
            <td>${sci(c.maxAbsXyzError)}</td><td>${sci(c.maxAbsDistanceDiff)}</td>
            <td class="${c.framesIdentical ? 'ok' : 'bad'}">${c.framesIdentical === null ? '—' : (c.framesIdentical ? 'yes' : 'NO')}</td>
            <td class="${c.pass ? 'ok' : 'bad'}">${c.pass ? 'PASS' : 'FAIL'}</td>
          </tr>`).join('')}
        </table>`;
      }
      if ((report.measurements || []).length > 0) {
        html += `<table>
          <tr><th>measurement</th><th>buffer</th><th>fps</th><th>wall p95</th>
              <th>predeform p50</th><th>draw p50</th><th>draw p95</th><th>sort p50</th>
              <th>passes / changes</th><th>GL</th><th>valid</th></tr>
          ${report.measurements.map((m: any) => `<tr>
            <td>${m.label}</td>
            <td>${m.buffer.drawingBufferWidth}×${m.buffer.drawingBufferHeight}</td>
            <td>${num(m.effectiveFPS)}</td>
            <td>${num(m.frameInterval?.p95)}</td>
            <td>${num(m.gpuPredeformMs?.p50)}</td>
            <td>${num(m.gpuDrawMs?.p50)}</td>
            <td>${num(m.gpuDrawMs?.p95)}</td>
            <td>${num(m.gpuSortMs?.p50)}</td>
            <td>${m.predeformPassCount} / ${m.weightUploadCount ?? '—'}</td>
            <td>${m.glErrors}</td>
            <td class="${m.valid ? 'ok' : 'bad'}">${m.valid ? 'yes' : 'no'}</td>
          </tr>`).join('')}
        </table>`;
      }
      // The investigation and the sweep both report `frames`, with different shapes.
      if ((report.frames || []).length > 0 && report.frames[0].repeatability) {
        html += `<table>
          <tr><th>frame</th><th>prod unique</th><th>poc unique</th><th>hash equal</th>
              <th>diff px</th><th>diff %</th><th>max byte Δ</th><th>alpha same</th>
              <th>RGB only</th><th>centre ΔULP max</th><th>centre diff comps</th></tr>
          ${report.frames.map((f: any) => {
            const c = (f.centerDiffs || []).find((d: any) => d.left === 'production-attribute' && d.right === 'predeform');
            return `<tr>
              <td>${f.frame}</td>
              <td>${f.repeatability.production.uniqueHashes.length}</td>
              <td>${f.repeatability.predeform.uniqueHashes.length}</td>
              <td class="${f.pixelDiff.hashes.identical ? 'ok' : 'bad'}">${f.pixelDiff.hashes.identical ? 'yes' : 'NO'}</td>
              <td>${f.pixelDiff.differentPixels}</td>
              <td>${(f.pixelDiff.differentPixelRatio * 100).toFixed(5)}</td>
              <td>${f.pixelDiff.maxRgbaByteDelta}</td>
              <td class="${f.pixelDiff.channelHashes.alphaPlaneIdentical ? 'ok' : 'bad'}">${f.pixelDiff.channelHashes.alphaPlaneIdentical ? 'yes' : 'NO'}</td>
              <td>${f.pixelDiff.channelHashes.rgbOnlyDifference ? 'yes' : 'no'}</td>
              <td>${c ? c.maxUlpDifference : '—'}</td>
              <td>${c ? c.differentComponents : '—'}</td>
            </tr>`;
          }).join('')}
        </table>
        <p class="note">classification: <b>${report.classification}</b></p>`;
      }
      if (report.contract) {
        const c = report.contract;
        html += `<table>
          <tr><th>acceptance ${c.acceptanceVersion}</th><th>verdict</th><th>passing</th></tr>
          <tr><td>structural</td><td class="${c.structural.verdict === 'PASS' ? 'ok' : 'bad'}">${c.structural.verdict}</td><td>${c.structural.samplesCompared}/${c.structural.samplesExpected} samples, GL ${c.structural.glErrors}, page ${c.structural.pageErrors}</td></tr>
          <tr><td>BIT_EXACT_EQUIVALENCE</td><td class="${c.bitExactVerdict === 'PASS' ? 'ok' : 'warn'}">${c.bitExactVerdict}</td><td>${c.counts.bitExactPassing}/${c.counts.total}</td></tr>
          <tr><td>NUMERIC_EQUIVALENCE</td><td class="${c.numericVerdict === 'PASS' ? 'ok' : 'bad'}">${c.numericVerdict}</td><td>${c.counts.numericPassing}/${c.counts.total}</td></tr>
          <tr><td>VISUAL_EQUIVALENCE</td><td class="${c.visualVerdict === 'PASS' ? 'ok' : 'bad'}">${c.visualVerdict}</td><td>${c.counts.visualPassing}/${c.counts.total} within explicit tolerance</td></tr>
          <tr><td><b>correctnessVerdict</b></td><td class="${c.correctnessVerdict === 'PASS' ? 'ok' : 'bad'}"><b>${c.correctnessVerdict}</b></td><td>under ${c.previousAcceptanceVersion}: ${c.underPreviousAcceptance}</td></tr>
        </table>`;
      }
      if (report.summary) {
        const s = report.summary;
        const w = (x: any) => `${typeof x.value === 'number' ? (Number.isInteger(x.value) ? x.value : x.value.toExponential(4)) : '—'} @f${x.frame}`;
        html += `<table>
          <tr><th>sweep summary</th><th>value</th></tr>
          <tr><td>frames compared</td><td>${s.framesCompared}</td></tr>
          <tr><td>pixel-identical frames</td><td class="${s.framesWithPixelDifference === 0 ? 'ok' : ''}">${s.framesPixelIdentical}</td></tr>
          <tr><td>frames with a pixel difference</td><td class="${s.framesWithPixelDifference === 0 ? 'ok' : 'bad'}">${s.framesWithPixelDifference}</td></tr>
          <tr><td>worst differing pixels</td><td>${w(s.worstDifferentPixels)}</td></tr>
          <tr><td>worst differing-pixel ratio</td><td>${w(s.worstDifferentPixelRatio)}</td></tr>
          <tr><td>worst max byte delta</td><td>${w(s.worstMaxByteDelta)}</td></tr>
          <tr><td>worst centre max abs</td><td>${w(s.worstCenterMaxAbs)}</td></tr>
          <tr><td>worst centre mean abs</td><td>${w(s.worstCenterMeanAbs)}</td></tr>
          <tr><td>worst distance max abs</td><td>${w(s.worstDistanceMaxAbs)}</td></tr>
          <tr><td>worst centre vs CPU max abs</td><td>${w(s.worstCenterVsCpuMaxAbs)}</td></tr>
          <tr><td>worst ULP (diagnostic only)</td><td>${s.worstMaxUlp.value} @f${s.worstMaxUlp.frame}, abs ${s.worstMaxUlp.absAtThatComponent.toExponential(4)}</td></tr>
          <tr><td>frames with an alpha difference</td><td class="${s.framesWithAlphaDifference.length === 0 ? 'ok' : 'bad'}">${s.framesWithAlphaDifference.length === 0 ? 'none' : s.framesWithAlphaDifference.join(', ')}</td></tr>
          <tr><td>frames with non-finite centres</td><td class="${s.framesWithNonFinite.length === 0 ? 'ok' : 'bad'}">${s.framesWithNonFinite.length === 0 ? 'none' : s.framesWithNonFinite.join(', ')}</td></tr>
          <tr><td>all within ${report.numericBound}</td><td class="${s.allWithinNumericBound ? 'ok' : 'bad'}">${s.allWithinNumericBound ? 'yes' : `NO: ${s.framesOutsideNumericBound.join(', ')}`}</td></tr>
        </table>`;
        const diff = (report.frames || []).filter((f: any) => f.framebuffer && !f.framebuffer.pixelIdentical);
        if (diff.length > 0) {
          html += `<table>
            <tr><th>frame with a pixel difference</th><th>diff px</th><th>ratio</th><th>max byte Δ</th>
                <th>R/G/B/A differing</th><th>alpha same</th><th>centre max abs</th><th>dist max abs</th></tr>
            ${diff.map((f: any) => `<tr>
              <td>${f.frame}</td>
              <td>${f.framebuffer.differentPixels}</td>
              <td>${f.framebuffer.differentPixelRatio.toExponential(3)}</td>
              <td>${f.framebuffer.maxRgbaByteDelta}</td>
              <td>${f.framebuffer.rDifferingCount}/${f.framebuffer.gDifferingCount}/${f.framebuffer.bDifferingCount}/${f.framebuffer.aDifferingCount}</td>
              <td class="${f.framebuffer.alphaPlaneIdentical ? 'ok' : 'bad'}">${f.framebuffer.alphaPlaneIdentical ? 'yes' : 'NO'}</td>
              <td>${f.center.maxAbsXYZ.toExponential(4)}</td>
              <td>${f.distance.maxAbsDifference.toExponential(4)}</td>
            </tr>`).join('')}
          </table>`;
        }
      }
      if ((report.runs || []).length > 0 && report.target) {
        html += `<table>
          <tr><th>tail run</th><th>buffer</th><th>fps</th><th>exact p50</th><th>exact p95</th>
              <th>exact p99</th><th>polled p95</th><th>fence p95</th><th>readback p95</th>
              <th>cpu sort p95</th><th>index p95</th><th>total p95</th><th>inv fail</th>
              <th>req/sub/done/skip</th><th>valid</th></tr>
          ${report.runs.map((x: any) => `<tr>
            <td>${x.name}</td>
            <td>${x.buffer.drawingBufferWidth}×${x.buffer.drawingBufferHeight}</td>
            <td>${num(x.effectiveFPS)}</td>
            <td>${num(x.exactFrameInterval.p50)}</td>
            <td class="${x.exactFrameInterval.p95 <= report.target.maxExactWallP95Ms ? 'ok' : 'bad'}">${num(x.exactFrameInterval.p95)}</td>
            <td>${num(x.exactFrameInterval.p99)}</td>
            <td>${num(x.polledFrameInterval.p95)}</td>
            <td>${num(x.sortLifecycle.fenceWaitMs.p95)}</td>
            <td>${num(x.sortLifecycle.readbackMs.p95)}</td>
            <td>${num(x.sortLifecycle.cpuSortMs.p95)}</td>
            <td>${num(x.sortLifecycle.indexUpdateMs.p95)}</td>
            <td>${num(x.sortLifecycle.totalLifecycleMs.p95)}</td>
            <td class="${x.sortLifecycle.lifecycleInvariantFailures === 0 ? 'ok' : 'bad'}">${x.sortLifecycle.lifecycleInvariantFailures}</td>
            <td>${x.sortCounters.sortRequestedCount}/${x.sortCounters.sortSubmittedCount}/${x.sortCounters.sortCompletedCount}/${x.sortCounters.sortPendingSkipCount}</td>
            <td class="${x.valid ? 'ok' : 'bad'}">${x.valid ? 'yes' : 'no'}</td>
          </tr>`).join('')}
        </table>
        <p class="note">classification: <b>${report.classification}</b>
          &middot; sort pipeline tail confirmed: ${report.sortPipelineTailConfirmed === null ? '—' : (report.sortPipelineTailConfirmed ? 'yes' : 'no')}
          &middot; residual above target: ${num(report.residualTailAboveTargetMs)} ms
          &middot; lifecycle invariant failures: ${(report.runs || []).reduce((s: number, x: any) => s + x.sortLifecycle.lifecycleInvariantFailures, 0)}</p>`;
      }
      tablesEl.innerHTML = html;
    };

    const renderStatus = () => {
      statusEl.textContent = JSON.stringify({
        runtime: runtime.report,
        fixture: replay.getFixture(),
        validation: replay.getValidation(),
        mapping: replay.getMapping(),
        report,
        lastError,
      }, null, 2);
      const busy = poc.isRunning() || investigation.isRunning() || tail.isRunning();
      btn.start.disabled = !runtime.report.ready || busy || !replay.getFixture();
      btn.investigate.disabled = !runtime.report.ready || busy || !replay.getFixture();
      btn.sweep.disabled = !runtime.report.ready || busy || !replay.getFixture();
      btn.tail.disabled = !runtime.report.ready || busy || !replay.getFixture();
      btn.stop.disabled = !busy;
      btn.export.disabled = !report;
      btn.copy.disabled = !report;
      renderLive();
      renderTables();
    };

    btn.start.addEventListener('click', async () => {
      report = null;
      lastError = null;
      renderStatus();
      try {
        report = await poc.run(predeformOptionsFromUrl());
      } catch (error: any) {
        lastError = error?.message || String(error);
        console.error('[UIKA GATE4B2A]', error);
      }
      renderStatus();
    });

    btn.investigate.addEventListener('click', async () => {
      report = null;
      lastError = null;
      renderStatus();
      try {
        report = await investigation.run(investigationOptionsFromUrl());
      } catch (error: any) {
        lastError = error?.message || String(error);
        console.error('[UIKA GATE4B2A INVESTIGATION]', error);
      }
      renderStatus();
    });

    btn.sweep.addEventListener('click', async () => {
      report = null;
      lastError = null;
      renderStatus();
      try {
        report = await investigation.runSweep(sweepOptionsFromUrl());
      } catch (error: any) {
        lastError = error?.message || String(error);
        console.error('[UIKA GATE4B2A SWEEP]', error);
      }
      renderStatus();
    });

    btn.tail.addEventListener('click', async () => {
      report = null;
      lastError = null;
      renderStatus();
      try {
        report = await tail.run(tailOptionsFromUrl());
      } catch (error: any) {
        lastError = error?.message || String(error);
        console.error('[UIKA GATE4B2B0]', error);
      }
      renderStatus();
    });

    btn.stop.addEventListener('click', () => { poc.stop(); investigation.stop(); tail.stop(); });

    btn.export.addEventListener('click', () => {
      const blob = new Blob([JSON.stringify(report, null, 2)], { type: 'application/json' });
      const a = document.createElement('a');
      a.href = URL.createObjectURL(blob);
      a.download = `uika-gate4b2a-${new Date().toISOString().replace(/[:.]/g, '-')}.json`;
      a.click();
      setTimeout(() => URL.revokeObjectURL(a.href), 2000);
    });

    btn.copy.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(JSON.stringify(report, null, 2));
        btn.copy.textContent = 'Copied';
        setTimeout(() => { btn.copy.textContent = 'Copy Results'; }, 1500);
      } catch (error: any) {
        lastError = `clipboard: ${error?.message || error}`;
        renderStatus();
      }
    });

    renderStatus();
    const timer = window.setInterval(renderStatus, 500);

    runtime.initializeNeutral()
      .then(async () => {
        await replay.loadBundled();
        replay.bindBasis(runtime.getAsset()!.basis.names);
        renderStatus();
      })
      .catch((error: any) => {
        lastError = error?.message || String(error);
        console.error('[UIKA GATE4B2A PAGE]', error);
        renderStatus();
      });

    window.addEventListener('beforeunload', () => {
      window.clearInterval(timer);
      runtime.dispose();
    }, { once: true });
  </script>
</body>
</html>
