---
// UIKA Native Runtime Architecture Correction v1.0 — Gate 1 only.
// Completely isolated from LAMAvatar / LAMWebSocketManager / LiveAudioManager.
---

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>UIKA Native v1 — Gate 1</title>
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      background: #111;
      color: #eee;
      font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
      padding: 16px;
    }
    h1 { margin: 0; font-size: 18px; }
    #viewer {
      width: min(720px, calc(100vw - 32px));
      aspect-ratio: 1 / 1;
      position: relative;
      overflow: hidden;
      background: #000;
      border: 1px solid #444;
    }
    #viewer :global(canvas) {
      width: 100% !important;
      height: 100% !important;
      display: block;
    }
    #status {
      width: min(720px, calc(100vw - 32px));
      min-height: 180px;
      margin: 0;
      white-space: pre-wrap;
      overflow-wrap: anywhere;
      padding: 12px;
      border: 1px solid #444;
      background: #181818;
    }
  </style>
</head>
<body>
  <h1>UIKA Native v1 — Gate 1 neutral render</h1>
  <div id="viewer"></div>
  <pre id="status">initializing...</pre>

  <script>
    import { UikaNativeDriver } from '../scripts/chat/uika-native/uika-native-driver';

    const container = document.getElementById('viewer');
    const statusEl = document.getElementById('status');

    if (!(container instanceof HTMLElement) || !(statusEl instanceof HTMLElement)) {
      throw new Error('UIKA Native Gate 1: page elements missing');
    }

    const driver = new UikaNativeDriver(container);
    (window as any).__uikaNativeV1Driver = driver;

    const renderStatus = () => {
      statusEl.textContent = JSON.stringify({
        runtime: driver.status,
        asset: driver.getAssetDebugInfo(),
      }, null, 2);
    };

    renderStatus();
    const timer = window.setInterval(renderStatus, 250);

    driver.initializeNeutral()
      .then(() => {
        renderStatus();
      })
      .catch((error) => {
        renderStatus();
        console.error('[UIKA NATIVE V1 PAGE]', error);
      });

    window.addEventListener('beforeunload', () => {
      window.clearInterval(timer);
      driver.dispose();
    }, { once: true });
  </script>
</body>
</html>
